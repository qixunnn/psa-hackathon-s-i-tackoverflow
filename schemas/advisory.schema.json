{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Advisory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "headline": { "type": "string" },
    "summary": { "type": "string" },
    "recommended_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "operator_decision": { "type": "string", "enum": ["pending", "accepted", "dismissed"] },
    "operator_comment": { "type": ["string", "null"] }
  },
  "required": ["run_id", "headline", "summary", "recommended_actions", "confidence", "operator_decision", "operator_comment"]
}
