{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Run",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["queued", "extracting", "assessing_risk", "retrieving_routes", "ranking", "advising", "complete", "halted_not_relevant", "error"]
    },
    "submitted_by": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string", "format": "uri" }
  },
  "required": ["run_id", "status", "submitted_by", "submitted_at", "source_url"]
}
