{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Run",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["queued", "extracting", "awaiting_manual_text", "assessing_risk", "retrieving_routes", "ranking", "advising", "complete", "halted_not_relevant", "error"]
    },
    "submitted_by": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string", "format": "uri" },
    "event": { "$ref": "event.schema.json" },
    "risk_assessment": { "$ref": "risk_assessment.schema.json" },
    "candidate_routes": {
      "type": "array",
      "items": { "$ref": "candidate_route.schema.json" }
    }
  },
  "required": ["run_id", "status", "submitted_by", "submitted_at", "source_url"]
}
