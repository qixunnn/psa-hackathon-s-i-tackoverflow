{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "relevant": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string" },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string" },
        "event_type": { "type": "string" },
        "date": { "type": "string" },
        "actors": { "type": "array", "items": { "type": "string" } },
        "chokepoints_mentioned": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["location", "event_type", "date", "actors", "chokepoints_mentioned"]
    },
    "source_url": { "type": "string", "format": "uri" },
    "extracted_at": { "type": "string", "format": "date-time" }
  },
  "required": ["run_id", "relevant", "confidence", "summary", "entities", "source_url", "extracted_at"]
}
